DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=fileshare
PORT=9999

# Show all-time upload/download counters on the homepage (true/false)
SHOW_STATS=true

# Maximum file size per upload in bytes (default: 1 GB = 1073741824)
MAX_FILE_SIZE=1073741824

# Production only
# SSL_CERT=/etc/letsencrypt/live/yourdomain/fullchain.pem
# SSL_KEY=/etc/letsencrypt/live/yourdomain/privkey.pem
# PEER_HOST=yourdomain.com
